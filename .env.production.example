# ==============================================================================
# Builders LMS - Production Environment Configuration
# ==============================================================================

# Domain Configuration
SITE_DOMAIN=lms.builders.sa

# Security Credentials (Change these in production!)
ADMIN_PASSWORD=ChangeMeWithStrongPass2026!
DB_ROOT_PASSWORD=ChangeMeWithSecureDbPass2026!

# Email / SMTP Settings (For transactional emails: registrations, certificates, invoices)
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_LOGIN=apikey
MAIL_PASSWORD=YOUR_SENDGRID_OR_SES_KEY
MAIL_SENDER=noreply@builders.sa

# Payment Gateways (GCC / Gulf Region)
# Tap Payments (Saudi Arabia, UAE, Kuwait, Qatar, Bahrain, Oman)
TAP_SECRET_KEY=sk_live_...
TAP_PUBLIC_KEY=pk_live_...

# Moyasar (Saudi Mada, Apple Pay, Visa/Mastercard)
MOYASAR_API_KEY=sk_live_...

# S3 Backup Storage (AWS S3 or Cloudflare R2)
BACKUP_S3_KEY=...
BACKUP_S3_SECRET=...
BACKUP_S3_BUCKET=builders-lms-backups
BACKUP_S3_REGION=me-central-1
